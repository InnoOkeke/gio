# GIO Environment Configuration
# Copy this file to .env and fill in your values

# â”€â”€ AWS Bedrock â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# The AI assistant calls Bedrock's OpenAI-compatible Chat Completions API on the
# bedrock-mantle endpoint (https://bedrock-mantle.<AWS_REGION>.api.aws/v1/chat/completions).
# Auth is an Amazon Bedrock API key (Bedrock console > API keys). All three values are required.
# Model IDs for this endpoint have no version suffix; list them with GET /v1/models.
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=qwen.qwen3-coder-480b-a35b-instruct

# â”€â”€ App Configuration â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=3001
NODE_ENV=development

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DB_PATH=./data/gio.db

# -- AI safety --
# AI requests per UTC day for the whole site (all visitors together).
AI_DAILY_LIMIT=2000
