{
  "name": "gio",
  "version": "0.1.0",
  "description": "Logo resurrected for the modern web: AI-assisted turtle coding for kids. Kiroween 2026 Resurrection entry",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "nodemon --exec tsx src/api/server.ts",
    "dev:ui": "vite",
    "build": "tsc -p tsconfig.api.json && vite build",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "check:python": "tsx scripts/check-python.ts",
    "check:tutor": "tsx scripts/check-tutor.ts",
    "check:browser": "tsx scripts/browser-check.ts",
    "check:shots": "tsx scripts/gio-shots.ts",
    "check:map-shots": "tsx scripts/map-shots.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "11.3.0",
    "concurrently": "9.1.0",
    "cors": "2.8.5",
    "dotenv": "18.0.10",
    "express": "4.19.2",
    "helmet": "8.0.0",
    "nodemon": "3.1.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/nunito": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/better-sqlite3": "7.6.11",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.4.1",
    "@types/react": "18.3.4",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "fast-check": "3.22.0",
    "postcss": "8.4.41",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.1",
    "tailwindcss": "3.4.10",
    "tsx": "4.16.2",
    "typescript": "5.5.4",
    "vite": "5.4.0",
    "vitest": "2.0.5"
  },
  "keywords": [
    "logo",
    "turtle-graphics",
    "education",
    "resurrection",
    "kiro",
    "kiroween",
    "ai"
  ]
}
