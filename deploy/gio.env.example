# Server settings for GIO (copied to /etc/gio/gio.env by setup.sh if it doesn't exist).
# No secrets here: the Bedrock API key lives in Parameter Store, named by GIO_SECRET_PARAM.
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=qwen.qwen3-coder-480b-a35b-instruct
GIO_SECRET_PARAM=gio-bedrock-api-key
AI_DAILY_LIMIT=2000
PORT=3001
DB_PATH=/var/lib/gio/gio.db
# nginx passes the visitor's address (taken from API Gateway's Forwarded header) as the only
# X-Forwarded-For entry, so the app trusts one proxy hop and rate limits use the real visitor.
TRUST_PROXY=1
